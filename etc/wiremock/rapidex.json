{
  "request": {
    "method": "POST",
    "url": "/api/delivery-cost",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.originZipCode"
      },
      {
        "matchesJsonPath": "$.destinationZipCode"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "deliveryCost": "50.00",
      "estimatedDaysToDeliver": "5"
    }
  }
}
